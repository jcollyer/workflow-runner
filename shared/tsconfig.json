{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": [],
    "skipLibCheck": true,

    /* Consumed as source by both Vite (bundler) and Node (nodenext); nodenext is the stricter of the two. */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
